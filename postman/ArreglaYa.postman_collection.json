{
  "info": {
    "name": "ArreglaYa API",
    "description": "Coleccion de la API de ArreglaYa. Ejecutar primero 'python manage.py crear_datos_prueba' y poner en la variable password_prueba la misma clave de PASSWORD_USUARIOS_PRUEBA del archivo .env.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Autenticacion",
      "item": [
        {
          "name": "Obtener token admin1 (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/token/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "token",
                ""
              ]
            },
            "description": "Devuelve el token de admin1. Lo guarda en la variable token_admin.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin1\",\n  \"password\": \"{{password_prueba}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    pm.collectionVariables.set('token_admin', pm.response.json().token);",
                  "}",
                  "pm.test('Responde 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
